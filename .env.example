# Copy this file to ".env" (same folder, project root) and fill in your own values.
#   Windows:  copy .env.example .env
# ".env" is git-ignored, so your real key never gets committed.
# Do NOT put a real key in this example file.

# Powers the customer support chatbot (php/chatbot.php).
# Get a key at https://console.anthropic.com/ (API keys), and set a spending limit on it.
ANTHROPIC_API_KEY=paste-your-key-here

# --- Optional: only needed when deploying to production, or testing ---
# --- these specific features locally. Leave unset otherwise.        ---

# Database (php/db.php). Unset = falls back to XAMPP's local defaults
# (localhost / styled_db / root / no password), so local dev needs none
# of these. Set all four when deploying, or to point local dev at a
# remote database.
# DB_HOST=localhost
# DB_NAME=styled_db
# DB_USER=root
# DB_PASS=

# PayMongo payment gateway (php/config/paymongo.php). Get these from the
# PayMongo Dashboard > Developers. Use TEST keys until the full checkout
# -> payment -> webhook flow is verified.
# PAYMONGO_SECRET_KEY=sk_test_...
# PAYMONGO_PUBLIC_KEY=pk_test_...
# REQUIRED for card/GCash/Maya orders to ever become "paid": the webhook's
# signing secret (Dashboard > Developers > Webhooks > your webhook > Signing
# secret). If this is unset the webhook refuses to run (HTTP 503).
# PAYMONGO_WEBHOOK_SECRET=whsec_...

# Google OAuth "Sign in with Google" (php/config/google_oauth.php). Get
# these from Google Cloud Console > APIs & Services > Credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Brevo transactional email (php/brevo_email.php).
# BREVO_API_KEY=
