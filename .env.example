# Copy this file to ".env" (same folder, project root) and fill in your own values.
#   Windows:  copy .env.example .env
# ".env" is git-ignored, so your real key never gets committed.
# Do NOT put a real key in this example file.

# Powers the customer support chatbot (php/chatbot.php).
# Get a key at https://console.anthropic.com/ (API keys), and set a spending limit on it.
ANTHROPIC_API_KEY=paste-your-key-here
